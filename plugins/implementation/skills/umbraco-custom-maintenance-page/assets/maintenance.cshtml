<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scheduled Maintenance</title>
    <style>
        :root{--umb-dark:#1B1B1B;--umb-gray:#6B7280;--umb-light:#F5F5F5;--umb-white:#fff;--umb-alert:#f5c1bc}
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;background:var(--umb-light);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px}
        .container{background:var(--umb-white);border-radius:24px;padding:2.5rem;max-width:480px;width:100%;box-shadow:0 20px 40px rgba(0,0,0,0.2);text-align:center}
        h1{color:var(--umb-dark);font-size:1.75rem;font-weight:700;margin-bottom:0.75rem}
        p{color:var(--umb-gray);font-size:1rem;line-height:1.6;margin-bottom:1.5rem}
        .status-badge{display:inline-flex;align-items:center;gap:8px;background:var(--umb-alert);color:var(--umb-dark);padding:8px 16px;border-radius:20px;font-size:0.875rem;font-weight:600;margin-bottom:1.5rem}
        .spinner{width:14px;height:14px;border:2px solid var(--umb-dark);border-bottom-color:transparent;border-radius:50%;animation:spin 1s linear infinite}
        @keyframes spin{to{transform:rotate(360deg)}}
    </style>
</head>
<body>
    <!-- STAY UNDER 5MB -->
    <div class="container">
        <h1>We'll be right back</h1>
        <p>Performing scheduled updates to improve your experience. Thanks for your patience!</p>
        <div class="status-badge">
            <span class="spinner"></span>
            <span>Checking status... No need to refresh</span>
        </div>
    </div>
     <script>
        const currentHost = window.location.hostname;
        const orangeDomain = "orange-brand.com"; 

        if (currentHost.includes(orangeDomain)) {
            // do markup changes based on domain
        }
        
        const CHECK_INTERVAL = 5000; 

        function checkServer() {
            const checkUrl = window.location.origin + '/';

            fetch(checkUrl, { method: 'HEAD', cache: 'no-store' })
                .then(response => {
                    if (response.ok && response.status !== 503) {
                        window.location.reload();
                    }
                })
                .catch(error => {
                    console.log("Site is still undergoing maintenance...");
                });
        }

        setInterval(checkServer, CHECK_INTERVAL);
    </script>
</body>
</html>